# ============================================
# Application
# ============================================
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME=FBR Digital Invoicing Backend

# ============================================
# Database (MySQL)
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fbr_invoicing
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_DIALECT=mysql
DB_LOGGING=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# ============================================
# JWT Authentication
# ============================================
JWT_ACCESS_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_string_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ============================================
# Encryption (for FBR tokens in DB)
# Must be exactly 32 characters (256-bit AES)
# ============================================
ENCRYPTION_KEY=change_this_to_exactly_32_chars!!

# ============================================
# FBR / PRAL API
# ============================================
FBR_BASE_URL=https://gw.fbr.gov.pk
FBR_POST_INVOICE_SANDBOX=/di_data/v1/di/postinvoicedata_sb
FBR_POST_INVOICE_PRODUCTION=/di_data/v1/di/postinvoicedata
FBR_VALIDATE_INVOICE_SANDBOX=/di_data/v1/di/validateinvoicedata_sb
FBR_VALIDATE_INVOICE_PRODUCTION=/di_data/v1/di/validateinvoicedata
FBR_REF_PROVINCES=/pdi/v1/provinces
FBR_REF_DOCTYPE=/pdi/v1/doctypecode
FBR_REF_ITEMDESC=/pdi/v1/itemdesccode
FBR_REF_SROITEM=/pdi/v1/sroitemcode
FBR_REF_TRANSTYPE=/pdi/v1/transtypecode
FBR_REF_UOM=/pdi/v1/uom
FBR_REF_SROSCHED=/pdi/v1/SroSchedule
FBR_REF_SALETYPE_TO_RATE=/pdi/v2/SaleTypeToRate
FBR_REF_HS_UOM=/pdi/v2/HS_UOM
FBR_REF_SROITEM_V2=/pdi/v2/SROItem
FBR_STATL=/dist/v1/statl
FBR_GET_REG_TYPE=/dist/v1/Get_Reg_Type
FBR_REQUEST_TIMEOUT_MS=30000

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
LOG_DIR=logs
